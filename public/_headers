# Browser cache policy for Cloudflare Workers Static Assets.
# Default is `public, max-age=0, must-revalidate` — the browser stores each file
# but revalidates it on every visit (a 304 round-trip per file). With hundreds
# of asset files that makes repeat visits slower than they should be. These
# rules skip the revalidation.

# Vite-fingerprinted build output (the hash changes whenever the file does) —
# safe to cache forever.
/assets/*.js
  Cache-Control: public, max-age=31536000, immutable
/assets/*.css
  Cache-Control: public, max-age=31536000, immutable

# Game media: every URL the game requests carries a content version
# (`?v=<sha8>` from src/data/assetManifest.json `versions`, appended by
# src/data/assetUrl.ts — P6.6), so a regenerated file gets a NEW url and these
# can be cached forever. Rules must not overlap (Cloudflare merges every
# matching rule's headers), hence audio is matched by extension: the music
# manifest.json keeps the default revalidating policy (and is fetched
# `cache: 'no-cache'`). Anything new loaded from here MUST go through assetUrl.
/assets/sprites/*
  Cache-Control: public, max-age=31536000, immutable
/assets/audio/*.mp3
  Cache-Control: public, max-age=31536000, immutable
/assets/backgrounds/*
  Cache-Control: public, max-age=31536000, immutable
/assets/portraits/*
  Cache-Control: public, max-age=31536000, immutable
/assets/fatalities/*
  Cache-Control: public, max-age=31536000, immutable
/assets/vfx/*
  Cache-Control: public, max-age=31536000, immutable
/assets/ui/*
  Cache-Control: public, max-age=31536000, immutable
