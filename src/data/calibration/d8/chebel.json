  "lore": {
    "tagline": "The deck told me of your weakness.",
    "personality": "Mimos co-founder, filmmaker, and animal-spirit tarot reader. Serene and ceremonial; reads the cards mid-fight. Partner of Ygor.",
    "backstory": "Brazilian multimedia artist who founded the solarpunk café Mimos (born on Saturn, now on Mars) with Ygor. VJ, photographer, tea-ceremony host, and embroiderer of Sintography prints; arrived in 2023 at Vanessa’s invitation."
  },
  "arcade": {
    "motivation": "The animal-spirit deck laid out the entire bracket, so Chebel goes where the cards send her — and the Biennale is long overdue for a proper tea ceremony.",
    "ending": "Champion, Chebel serves tea to the defeated and reads the desert’s future in the deck. Ygor films the whole thing for the sci-fi cut. The card is The World, upright."
  }
