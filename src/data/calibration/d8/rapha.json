  "scale": 0.96,
  "lore": {
    "tagline": "The TabBastard. Built to last. You’re not.",
    "personality": "Toy-maker and pop-tab obsessive, and the only Martian present for every single year. Gruff and durable; hands his dirty work to Tubs, his claw-handed bot.",
    "backstory": "A founding Data Daddy who built the Render Beast with Vincent and owns the RaphaLots at 5th and E. Here since year-zero Brahman; in 2026 he built Tubs, a clamp-handed bot living in a yellow top tub."
  },
  "arcade": {
    "motivation": "Rapha has outlasted every Mars there ever was; the Biennale is just the newest thing to outlast. He enters — with Tubs — to prove the veteran still builds sturdier than anyone fights.",
    "ending": "Champion, Rapha adds the title to the pop-tab chain, where every tab outlasted someone. Tubs rates the whole tournament two claws out of ten. Then it’s back to the lot at 5th and E."
  }
}
