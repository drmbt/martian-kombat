# Secrets — never commit
.env
.env.local
.env.*.local

# OS
.DS_Store
Thumbs.db

# Node
node_modules/
dist/
.vite/
*.log

# Asset pipeline intermediates. The source FRAMES (assets/raw/frames/) and the
# Character-Studio edit overlays (assets/raw/edits/) stay versioned — they are
# hand-authored SOURCE, not regen intermediates: a fighter's packed sheet is
# built FROM its edits/ overlays, so dropping them loses the manual tuning.
# The CANONICAL sheets (assets/raw/canonical/, incl. ko/) are regen ANCHORS =
# source too: gen-frames, gen-fatality, gen-icons and the Studio read them as
# the identity reference, so losing one means a fighter can never be
# regenerated consistently. Same for vincent/yulia's painted style-tests (the
# CLI tools' anchor for those two) and the salton world-map style ref.
# Unshipped Studio drafts' state.json (design work that exists nowhere else)
# are versioned as well; shipped fighters' drafts embed base64 copies of their
# committed VO/fatality media (1.3–1.8 MB, rewritten on every save) and stay
# out, listed by name below.
# Everything else under assets/raw/ (qa reports/montages, keyed, stage raws,
# vfx, icons, music, voice-tests, creator img/, and the timestamped
# sprite-editor pack BACKUPS in sprite-edits/) is a regen intermediate and is
# kept OUT of the repo to avoid bloat — it lives in the PRIVATE R2 mirror
# (npm run raw:push / raw:pull, index in assets/raw-store.manifest.json; see
# docs/RAW_ASSET_STORE.md).
assets/raw/*
!assets/raw/frames/
!assets/raw/edits/
!assets/raw/canonical/
!assets/raw/style-tests/
assets/raw/style-tests/*
!assets/raw/style-tests/char-*-b-painted.*
!assets/raw/stages/
assets/raw/stages/*
!assets/raw/stages/salton.png
!assets/raw/stages/salton.prompt.txt
!assets/raw/creator/
assets/raw/creator/*/*
!assets/raw/creator/*/state.json
assets/raw/creator/ben/state.json
assets/raw/creator/catherine/state.json
assets/raw/creator/earl/state.json
assets/raw/creator/flo/state.json
assets/raw/creator/gene/state.json
assets/raw/creator/rapha/state.json
assets/raw/creator/vincent/state.json
assets/raw/creator/yulia/state.json
assets/veo-clips/
assets/frame-dumps/
*.mp4.tmp

# Editor
.vscode/
.idea/
*.swp
.lh/

# Python tool cache
__pycache__/
*.pyc
# Ableton sample-analysis sidecars (regenerated on load)
*.asd

# gen-mesh writes these next to each GLB (local run records, never shipped)
public/assets/3d/**/*.job.json
public/assets/3d/**/*.report.json
